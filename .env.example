# Copy to .env and fill in. .env is gitignored — never commit real keys.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Needed in production so Bila's webhook POST passes CSRF origin checks:
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Email receipts ---
# Used for links inside receipt emails — must be the public URL, not localhost.
SITE_URL=https://your-domain.com
DEFAULT_FROM_EMAIL=Chain Reaction <orders@your-domain.com>
# Leave EMAIL_HOST blank in development and receipts print to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=orders@your-domain.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
# Who gets alerted when a paid order lands. Comma-separated for more than one.
ORDER_NOTIFY_EMAIL=mutangishaun7@gmail.com

# --- Bila payments (https://docs.usebila.com) ---
# Sandbox: https://sandbox.usebila.com + sk_test_ key
# Live:    https://api.usebila.com    + sk_live_ key
BILA_BASE_URL=https://sandbox.usebila.com
BILA_API_KEY=sk_test_xxxxxxxxxxxx
BILA_WALLET_ID=00000000-0000-0000-0000-000000000000
# From the Bila console when you register the webhook endpoint:
#   https://your-domain.com/orders/webhook/bila/
BILA_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
BILA_COUNTRY=zm
BILA_FEE_BEARER=merchant
