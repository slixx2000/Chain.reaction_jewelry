# ─────────────────────────────────────────────────────────────────────────────
#  Chain Reaction — template. Copy to .env and fill in.
#  .env is gitignored; this file is committed, so keep it free of real values.
#  Run `.venv/bin/python manage.py check --deploy` after changing anything.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ──────────────────────────────────────────────────────────────
# Freshly generated for you. Use a DIFFERENT one in production.
DJANGO_SECRET_KEY=generate-with-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production only — the public origin, so Bila's webhook passes CSRF checks:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ── Bila payments ────────────────────────────────────────────────────────────
#   Sandbox: https://sandbox.usebila.com  + sk_test_ key
#   Live:    https://api.usebila.com      + sk_live_ key
# Get these from the Bila console. Checkout FAILS LOUDLY without them — that is
# deliberate, so a broken config can never look like a successful payment.
BILA_BASE_URL=https://sandbox.usebila.com
BILA_API_KEY=                      # TODO sk_test_...
BILA_WALLET_ID=                    # TODO uuid from the Bila console
# Console → Webhooks → add https://yourdomain.com/orders/webhook/bila/
# then copy the signing secret here. Without it EVERY webhook is rejected.
BILA_WEBHOOK_SECRET=               # TODO whsec_...
BILA_COUNTRY=zm
BILA_FEE_BEARER=merchant           # merchant | customer

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Leave EMAIL_HOST blank and receipts print to the console — fine for local dev.
# Resend: verify your domain first, then use the API key as the password.
EMAIL_HOST=                        # TODO smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=               # TODO re_...
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Chain Reaction <onboarding@resend.dev>
# Who gets told when a paid order lands. Comma-separated for more than one.
ORDER_NOTIFY_EMAIL=mutangishaun7@gmail.com
# Where customer replies land. The from-address above is send-only on Resend,
# so without this a reply to a receipt bounces. Falls back to ORDER_NOTIFY_EMAIL.
REPLY_TO_EMAIL=mutangishaun7@gmail.com

# Public URL used for links inside receipt emails. MUST NOT be localhost in
# production or every "view your order" link in a customer's inbox is dead.
SITE_URL=http://127.0.0.1:8001

# ─────────────────────────────────────────────────────────────────────────────
#  NOT WIRED UP YET — these do nothing until the Phase 1 work in hostingplan.md
#  is done. Listed here so you can collect the values in one pass.
# ─────────────────────────────────────────────────────────────────────────────

# ── Scheduled reconciliation ─────────────────────────────────────────────────
# An external scheduler (cron-job.org) POSTs to /orders/cron/reconcile/ with
# this value in an X-Cron-Token header, settling orders whose webhook was
# missed. Blank disables the endpoint. Generated for you:
CRON_TOKEN=generate-a-long-random-string

# ── Database (Neon / Supabase) ───────────────────────────────────────────────
# Absent, the app uses SQLite. On a hosted box that means orders vanish on
# every redeploy, so this is required before launch.
# DATABASE_URL=                    # TODO postgres://user:pass@host/db?sslmode=require

# ── Media storage (Cloudflare R2) ────────────────────────────────────────────
# Without this, uploaded product photos vanish on every redeploy.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=chainreaction-media
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://media.yourdomain.com
# …or Cloudinary instead, which also resizes and serves WebP:
# CLOUDINARY_URL=cloudinary://key:secret@cloud-name

# ── Monitoring ───────────────────────────────────────────────────────────────
# Sentry stays inert until a DSN is set. PII is deliberately not sent, so
# customer phone numbers and addresses never leave the app.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Tunables (all have sensible defaults) ────────────────────────────────────
# MAX_UPLOAD_BYTES=8388608          # 8MB cap on image uploads
# RATELIMIT_ENABLE=True             # set False only to debug a limit locally
# LEGAL_UPDATED=10 August 2026      # date shown on terms / privacy / returns

# ── Production hardening ─────────────────────────────────────────────────────
# Turn on only once HTTPS is confirmed working — HSTS is hard to undo.
# SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_SSL_REDIRECT=True
